#ifndef INC_ARQ_H_
#define INC_ARQ_H_

#include "stm32c0xx_hal.h"
#include <stdint.h>
#include <stdbool.h>
#include <string.h>
#include <stdlib.h>
#include "logic.h"

#define FLAG_REQ_ACK  (1u<<0)
#define FLAG_IS_RETX  (1u<<1)

enum {
	T_DATA = 0,
	T_ACK,
	T_NAK,
	T_PING,
	T_PONG
};

typedef struct {
    uint8_t msg_type;
    uint8_t src;
    uint8_t dst;
    uint8_t seq;
    uint8_t flags;   // bit0 REQ_ACK, bit1 IS_RETX
} __attribute__((packed)) RHdr;

typedef enum { S_IDLE, S_WAIT_ACK, S_RETX } TxState;

typedef struct {
    TxState st;
    uint8_t next_seq;
    uint8_t pending_seq;
    uint8_t retries_left;
    uint32_t t_expire_ms;

    uint8_t frame[1 + 1 + 2 + MAX_PAYLOAD + 2 + 1]; // max wire
    uint16_t frame_len;
} ArqTx;

ArqTx arq;


#endif /* INC_ARQ_H_ */
