#include "frame.h"


static inline uint16_t cb_next(uint16_t x){
	return (uint16_t)((x + 1) % UART_CIRC_BUFFER_SIZE);
}

void CircularBuffer_Init(CircularBuffer* cb){
	cb->head=0;
	cb->tail=0;
}

static inline void FP_Init(FrameParser* fp, uint8_t* out, uint16_t out_cap) {
    fp->st = START_FRAME;
    fp->len = fp->got = 0;
    fp->rx_crc = fp->crc = 0xFFFF;   // seed matches CCITT-FALSE
    fp->out = out;
    fp->out_cap = out_cap;
}


void CircularBuffer_Push(CircularBuffer* cb, uint8_t c){
	uint16_t next_head = cb_next(cb->head);
	if (next_head == cb-> tail){
		//drop oldest
		cb->tail = cb_next(cb->tail);
	}
	cb->buffer[cb->head] = c;
	cb->head = next_head;
}


// Helpers to read one byte from your circular buffer (non-blocking)
static inline bool cb_try_get(CircularBuffer* cb, uint8_t* out){
    if (cb->head == cb->tail) return false;
    *out = cb->buffer[cb->tail];
    cb->tail = cb_next(cb->tail);
    return true;
}

static inline uint16_t cb_count(const CircularBuffer* cb){
	int16_t diff = (int16_t)cb->head - (int16_t )cb->tail;
	if (diff < 0) diff += UART_CIRC_BUFFER_SIZE;
	return (uint16_t)diff;
}

static inline void cb_advance_tail(CircularBuffer* cb, uint16_t n){
	cb -> tail = (cb->tail + n) % UART_CIRC_BUFFER_SIZE;

}

static uint16_t crc16_ccitt(const uint8_t* data, uint16_t len){
	uint16_t crc = 0XFFFF;
	for(uint16_t i = 0; i <len; i++){
		crc = crc ^ (uint16_t)data[i] << 8;

		for (int b = 0; b < 8; b++){
			if (crc & 0x8000){ // msb is 1
				crc = (crc << 1) ^ 0x1021 ; // 0b 0001 0000 0010 0001
			}else{
				crc <<= 1;
			}
		}
	}
	return crc;
}


// CRC16-CCITT(0x1021), init = 0xFFFF, no final XOR
static inline void crc16_ccitt_update(uint16_t* crc, uint8_t byte){
    *crc ^= (uint16_t)byte << 8;
    for (int i = 0; i < 8; ++i) {
        if (*crc & 0x8000) *crc = (*crc << 1) ^ 0x1021;
        else               *crc <<= 1;
    }
}




/*
 * Tries to extract ONE valid frame.
 * Returns:
 *   >0  => payload length written to out (0..MAX_PAYLOAD)
 *    0  => need more data (no decision)
 *   -1  => skipped noise/invalid bytes (kept scanning; you can call again)
 *
 * out      : buffer to write payload
 * out_size : size of out (>= MAX_PAYLOAD recommended)
 */

// FRAME:
// [SYNC1=0xFF][SYNC2=0x5A][LEN_L][LEN_H][PAYLOAD ... LEN bytes][CRC_L][CRC_H][END=0x00]
// [SYNC1=0xFF][SYNC2=0x5A][LEN_L][LEN_H][HDR.msg_type][HDR.src][HDR.dst][HDR.seq][HDR.flags][USER_DATA ...][CRC_L][CRC_H][END=0x00]


// Returns the *current* state label that is useful for debugging UI/logs.
// Typical return values per call: NO_DATA, SKIPPED, GOOD_FRAME, or the working state.
FrameParserState FP_Tick(FrameParser* fp, CircularBuffer* cb)
{
    uint8_t b;

    switch (fp->st){

		case START_FRAME:
			fp->len = fp->got = 0;
			fp->rx_crc = 0;
			fp->crc = 0xFFFF;
			fp->st = SYNC_1;
			return fp->st;

		case SYNC_1:
			if (!cb_try_get(cb, &b)) return NO_DATA;

			if (b == SYNC1) { fp->st = SYNC_2; return fp->st; }
			// skip garbage and keep hunting
			return SKIPPED;

		case SYNC_2:
			if (!cb_try_get(cb, &b)) return NO_DATA;

			if (b == SYNC2) { fp->st = LEN_L; return fp->st; }
			// false start; drop one byte and hunt again
			fp->st = SYNC_1;
			return SKIPPED;

		case LEN_L:
			if (!cb_try_get(cb, &b)) return NO_DATA;

			fp->len = b;
			crc16_ccitt_update(&fp->crc, b);

			fp->st = LEN_H;
			return fp->st;

		case LEN_H:
			if (!cb_try_get(cb, &b)) return NO_DATA;

			fp->len |= ((uint16_t)b << 8);
			crc16_ccitt_update(&fp->crc, b);

			// sanity checks
			if (fp->len > MAX_PAYLOAD || fp->len > fp->out_cap) {
				// absurd length; resync by restarting at SYNC_1
				fp->st = SYNC_1;
				return SKIPPED;
			}

			fp->got = 0;

			fp->st = (fp->len == 0) ? CRC_L_READ : PAYLOAD2BUFFER;

			return fp->st;

		case PAYLOAD2BUFFER:
			if (!cb_try_get(cb, &b)) return NO_DATA;

			fp->out[fp->got++] = b;

			crc16_ccitt_update(&fp->crc, b);

			if (fp->got >= fp->len) {
				fp->st = CRC_L_READ;
			}

			return fp->st;

		case CRC_L_READ:
			if (!cb_try_get(cb, &b)) return NO_DATA;

			fp->rx_crc = b;            // low
			fp->st = CRC_H_READ;

			return fp->st;

		case CRC_H_READ:
			if (!cb_try_get(cb, &b)) return NO_DATA;

			fp->rx_crc |= ((uint16_t)b << 8);  // high
			fp->st = END_READ;

			return fp->st;

		case END_READ:
			if (!cb_try_get(cb, &b)) return NO_DATA;

			if (b != END_BYTE) {
				// bad end guard; restart hunt
				fp->st = SYNC_1;
				return SKIPPED;
			}

			fp->st = CRC_VALIDATE;
			return fp->st;

		case CRC_VALIDATE:
			if (fp->crc == fp->rx_crc) {
				// Success: leave in GOOD_FRAME so the caller can act once
				fp->st = GOOD_FRAME;
				return fp->st;
			} else {
				// CRC mismatch -> restart hunt
				fp->st = SYNC_1;
				return SKIPPED;
			}

		case GOOD_FRAME:
			// Caller should consume data and then re-init state to START_FRAME:
			//    FP_Init(&fp, out, cap);  OR:
			//    fp.st = START_FRAME;
			return GOOD_FRAME;

		case NO_DATA:
		case SKIPPED:
			// not used as persistent states here; returned as outcomes
			return fp->st;
	}

    // Shouldn’t reach
    fp->st = START_FRAME;
    return START_FRAME;
}

// Returns total bytes placed in out, or 0 on error.
// out must be >= 1+1+2+plen+2+1
uint16_t UART_BuildFrame(const uint8_t* payload, uint16_t plen, uint8_t* out, uint16_t out_cap){
    if (plen > MAX_PAYLOAD) return 0;
    const uint16_t need = 1 + 1 + 2 + plen + 2 + 1;
    if (out_cap < need) return 0;

    uint16_t pos = 0;
    out[pos++] = SYNC1;
    out[pos++] = SYNC2;
    out[pos++] = (uint8_t)(plen & 0xFF);
    out[pos++] = (uint8_t)(plen >> 8);
    memcpy(&out[pos], payload, plen);
    pos += plen;

    uint8_t crcbuf[2 + MAX_PAYLOAD];
    crcbuf[0] = (uint8_t)(plen & 0xFF);
    crcbuf[1] = (uint8_t)(plen >> 8);
    memcpy(&crcbuf[2], payload, plen);
    uint16_t crc = crc16_ccitt(crcbuf, (uint16_t)(2 + plen));
    out[pos++] = (uint8_t)(crc & 0xFF);
    out[pos++] = (uint8_t)(crc >> 8);
    out[pos++] = END_BYTE;
    return pos;
}



// TODO fix circular buffer with hot swaps
bool CircularBuffer_ReadLine(CircularBuffer* cb, char* out, size_t max_len) {
    size_t i = 0;
    size_t pos = cb->tail;

    // 1. Busca si hay un '\n' en el buffer
    int found = 0;
    while (pos != cb->head && i < max_len - 1) {
        char c = cb->buffer[pos];
        if (c == '\n') {
            found = 1;
            break;
        }
        pos = (pos + 1) % UART_CIRC_BUFFER_SIZE;
        i++;
    }
    if (!found) return false; // No hay línea completa

    // 2. Copia la línea completa
    i = 0;
    while (cb->tail != cb->head && i < max_len - 1) {
        char c = cb->buffer[cb->tail];
        cb->tail = (cb->tail + 1) % UART_CIRC_BUFFER_SIZE;
        if (c == '\n') break;
        if (c != '\r' && c != '\0')
            out[i++] = c;
    }
    out[i] = '\0';
    return (i > 0);
}


